# Εικονικό περιβάλλον και προσωρινά αρχεία εργαλείων
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Αρχεία packaging
*.egg-info/
build/
dist/

# Δεδομένα (ξαναδημιουργούνται από το ingestion pipeline) και μυστικά
/data/
.env
# Κάθε παραλλαγή αρχείου ρυθμίσεων (π.χ. .env.txt από τον Notepad, .env.local) μένει εκτός git.
.env.*
!.env.example

# Παραδοτέα και πρόσθετα υλικά που δεν ανεβαίνουν στο repo
*.pdf
*.pptx
extras/

# Τοπικές ρυθμίσεις εργαλείων και editors
.claude/settings.local.json
.idea/
.vscode/
