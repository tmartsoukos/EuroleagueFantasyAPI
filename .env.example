# Παράδειγμα ρυθμίσεων. Αντίγραψε το σε αρχείο `.env` (το οποίο αγνοείται από το git).
# Εδώ υπάρχουν ΜΟΝΟ τιμές-κράτησης θέσης (placeholders): ποτέ πραγματικά μυστικά.

# Σύνδεση στη βάση. Τοπικά SQLite (προεπιλογή). Σε παραγωγή: Supabase Postgres μέσω του
# Supavisor «session pooler» (πόρτα 5432, δουλεύει με IPv4): Project -> Connect -> Session pooler.
# Το όνομα χρήστη είναι postgres.<project-ref>. Αν ο κωδικός έχει ειδικούς χαρακτήρες, γράψ' τον με
# URL-encoding (@ -> %40, / -> %2F, : -> %3A, # -> %23). Το Supabase υποστηρίζει SSL: το
# sslmode=require το επιβάλλει από την πλευρά του client. Το σχήμα της βάσης δημιουργείται ΜΟΝΟ με
# `python -m elfantasy.db.migrate` (docs/DATABASE.md). ΠΟΤΕ μην γράψεις πραγματικό κωδικό σε αρχείο
# που γίνεται commit· το πραγματικό URL μπαίνει σε `.env` (αγνοείται από το git) ή στο περιβάλλον.
# Παράδειγμα (κράτηση θέσης):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///data/elfantasy.db

# Προαιρετικό, ΜΟΝΟ για τα tests: URL ενός ΤΟΠΙΚΟΥ server Postgres (localhost) για τα tests με
# marker `postgres`. Τα tests αρνούνται οποιονδήποτε άλλον host. Χωρίς αυτό χρησιμοποιείται ο
# ενσωματωμένος Postgres του πακέτου pixeltable-pgserver (requirements-dev.txt).
# TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres
# Προαιρετικό, ΜΟΝΟ για τα tests: δηλώνει ότι ο server του TEST_DATABASE_URL είναι προσωρινός (όπως
# το service container του CI), ώστε να τρέξει και το test που δημιουργεί στο cluster τους ρόλους
# anon και authenticated του Supabase. ΜΗΝ το ορίσεις σε server που χρησιμοποιείς για άλλη δουλειά.
# ELFANTASY_PG_DISPOSABLE=1

# Φάκελος δεδομένων: raw cache (data/raw), αναφορές (data/reports) και logs (data/logs).
DATA_DIR=data

# Διαδρομή του αποθηκευμένου μοντέλου (artifact).
MODEL_PATH=models/model.joblib

# Όριο MAE (σε μονάδες fantasy score) για το quality gate: το `python -m elfantasy.model.train`
# γράφει μοντέλο μόνο αν το honest test MAE (σεζόν 2025) είναι μικρότερο, και το
# tests/quality/test_model_quality.py το ελέγχει στο committed μοντέλο. Το 6.00 προκύπτει από το
# backtest της Φάσης 3: μοντέλο 5.909, καλύτερο naive baseline 6.148 (docs/MODEL.md, ενότητα 8).
# Τιμή ≤ 0 σημαίνει «δεν έχει οριστεί»: η εκπαίδευση αποτυγχάνει με σαφές μήνυμα.
MAE_THRESHOLD=6.00

# Κλειδί για τα προστατευμένα endpoints του API (header X-API-Key: POST /availability,
# DELETE /availability/{player_id}, POST /admin/refresh). Βάλε μεγάλη τυχαία τιμή, π.χ. από
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. ΚΕΝΟ = τα endpoints αυτά είναι
# κλειστά (HTTP 503, ποτέ ανοιχτά): γι' αυτό η προεπιλογή εδώ είναι κενή και όχι μια εύκολη τιμή.
ADMIN_API_KEY=
