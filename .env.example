# Παράδειγμα ρυθμίσεων. Αντίγραψε το σε αρχείο `.env` (το οποίο αγνοείται από το git).
# Εδώ υπάρχουν ΜΟΝΟ τιμές-κράτησης θέσης (placeholders): ποτέ πραγματικά μυστικά.

# Σύνδεση στη βάση. Τοπικά SQLite. Σε παραγωγή: Supabase Postgres (pooler), π.χ.
# postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=sqlite:///data/elfantasy.db

# Φάκελος δεδομένων: raw cache (data/raw), αναφορές (data/reports) και logs (data/logs).
DATA_DIR=data

# Διαδρομή του αποθηκευμένου μοντέλου (artifact).
MODEL_PATH=models/model.joblib

# Όριο MAE (σε μονάδες fantasy score) για το quality gate: το `python -m elfantasy.model.train`
# γράφει μοντέλο μόνο αν το honest test MAE (σεζόν 2025) είναι μικρότερο, και το
# tests/quality/test_model_quality.py το ελέγχει στο committed μοντέλο. Το 6.00 προκύπτει από το
# backtest της Φάσης 3: μοντέλο 5.909, καλύτερο naive baseline 6.148 (docs/MODEL.md, ενότητα 8).
# Τιμή ≤ 0 σημαίνει «δεν έχει οριστεί»: η εκπαίδευση αποτυγχάνει με σαφές μήνυμα.
MAE_THRESHOLD=6.00

# Κλειδί για τα προστατευμένα endpoints του API (header X-API-Key: POST /availability,
# DELETE /availability/{player_id}, POST /admin/refresh). Βάλε μεγάλη τυχαία τιμή, π.χ. από
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. ΚΕΝΟ = τα endpoints αυτά είναι
# κλειστά (HTTP 503, ποτέ ανοιχτά): γι' αυτό η προεπιλογή εδώ είναι κενή και όχι μια εύκολη τιμή.
ADMIN_API_KEY=
